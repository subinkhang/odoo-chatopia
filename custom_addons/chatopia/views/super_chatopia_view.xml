        action="chatopia_action_inbox"
        sequence="10"/> -->

    <menuitem id="menu_chatopia_starred"
        name="Starred"
        parent="chatopia.menu_chatopia_root"
        action="chatopia_action_starred"
        sequence="20"/>

    <menuitem id="menu_chatopia_history"
        name="Chatopia"
        parent="chatopia.menu_chatopia_root"
        action="chatopia_action_history"
        sequence="30"/>

