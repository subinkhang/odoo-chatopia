<odoo>
    <menuitem id="menu_chatopia_root" name="Chatopia"/>
    <record id="view_chat_conversation_tree" model="ir.ui.view">
        <field name="name">chat.conversation.tree</field>
        <field name="model">chatopia.conversation</field>
        <field name="arch" type="xml">
            <tree string="Conversations" class="chatopia-table">
                <field name="chatwoot_conversation_id" class="chatopia-field"/>
                <field name="inbox_name" class="chatopia-field"/>
                <field name="sender_name" class="chatopia-field"/>
                <field name="contact_id" class="chatopia-field"/>
            </tree>
        </field>
    </record>

    <record id="view_chat_conversation_form" model="ir.ui.view">
        <field name="name">chat.conversation.form</field>
        <field name="model">chatopia.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation" class="chatopia-form">
                <sheet class="chatopia-sheet">
                    <group class="chatopia-group">
                        <field name="chatwoot_conversation_id" readonly="1" class="chatopia-field-readonly"/>
                        <field name="inbox_name" readonly="1" class="chatopia-field-readonly"/>
                        <field name="sender_name" readonly="1" class="chatopia-field-readonly"/>
                        <field name="contact_id" class="chatopia-field"/>
                        <field name="x_chatwoot_contact_id" class="chatopia-field"/>
                        <field name="x_chatwoot_inbox_id" class="chatopia-field"/>
                    </group>
                    <notebook class="chatopia-notebook">
                        <page string="Messages" class="chatopia-page">
                            <field name="message_ids">
                                <tree string="Messages" class="chatopia-message-table">
                                    <field name="sender" class="chatopia-field"/>
                                    <field name="content" class="chatopia-field chatopia-content"/>
                                    <field name="chatwoot_message_id" class="chatopia-field"/>
                                </tree>
                            </field>
                            <group string="Reply" class="chatopia-reply-group">
                                <field name="message_content" placeholder="Enter your message..." nolabel="1" class="chatopia-input"/>
                                <button name="send_message" string="Send" type="object" class="btn-primary chatopia-button"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>