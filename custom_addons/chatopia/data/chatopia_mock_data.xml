        <field name="sender">Nguyễn Văn An</field>
        <field name="content">Chào shop, tôi muốn hỏi về sản phẩm ABC.</field>
        <field name="conversation_id" ref="conv_001"/>
        <field name="message_type">user</field>
        <field name="created_at">2023-10-26 10:00:00</field>
        <field name="is_read">True</field>
    </record>
