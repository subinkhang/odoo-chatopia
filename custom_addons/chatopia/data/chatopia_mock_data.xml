        <field name="sender_name">Đại diện XYZ</field>
        <field name="inbox_names" eval='["Website Chat"]'/>
        <field name="sender_names" eval='["Đại diện XYZ"]'/>
        <field name="contact_id" ref="partner_cong_ty_c"/>
        <field name="contact_ids" eval="[(6, 0, [ref('partner_cong_ty_c'), ref('partner_khach_hang_a')])]" />
        <field name="x_chatwoot_contact_id">cw_contact_003</field>
        <field name="x_chatwoot_inbox_id">203</field>
        <field name="active">True</field>
    </record>

