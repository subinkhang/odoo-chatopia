    <!-- ======================== -->
    <!-- CHATOPIA.CONVERSATION  -->
    <!-- ======================== -->

    <!-- Conversation 1: Với Nguyễn Văn An, có 2 tin nhắn -->
    <record id="conv_001" model="chatopia.conversation">
        <field name="name">Hỏi về sản phẩm ABC - Nguyễn Văn An</field>
        <field name="chatwoot_conversation_id">1001</field>
        <field name="chatwoot_conversation_ids" eval="[1001]"/> <!-- Thêm ID chính vào list -->
        <field name="inbox_name">Zalo OA Chính</field>
        <field name="sender_name">Nguyễn Văn An</field>
        <field name="inbox_names" eval='["Zalo OA Chính", "Hotline 123"]'/>
        <field name="sender_names" eval='["Nguyễn Văn An", "An Nguyễn"]'/>
        <field name="contact_id" ref="partner_khach_hang_a"/>
        <field name="contact_ids" eval="[(6, 0, [ref('partner_khach_hang_a')])]" />
        <field name="x_chatwoot_contact_id">cw_contact_001</field>
        <field name="x_chatwoot_inbox_id">201</field>
        <field name="active">True</field> <!-- Đảm bảo active -->
    </record>

    <record id="conv_002" model="chatopia.conversation">
        <field name="name">Khiếu nại dịch vụ - Trần Thị Bình</field>
        <field name="chatwoot_conversation_id">1002</field>
        <field name="chatwoot_conversation_ids" eval="[1002]"/>
