    <!-- ======================== -->
    <!--      RES.PARTNER         -->
    <!-- ======================== -->
    <record id="partner_khach_hang_a" model="res.partner">
        <field name="name">Nguyễn Văn An</field>
        <field name="email">123456789@gmail.com</field>
        <field name="phone">+84901234567</field>
        <field name="company_type">person</field>
    </record>

    <record id="partner_khach_hang_b" model="res.partner">
        <field name="name">Trần Thị Bình</field>
        <field name="email">binhtt@example.com</field>
        <field name="phone">+84908765432</field>
        <field name="company_type">person</field>
    </record>

    <record id="partner_cong_ty_c" model="res.partner">
        <field name="name">Công Ty TNHH Giải Pháp XYZ</field>
        <field name="email">contact@xyzsolutions.com</field>
        <field name="phone">+842838123456</field>
