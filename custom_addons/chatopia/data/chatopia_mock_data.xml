        <field name="contact_id" ref="partner_khach_hang_b"/>
        <field name="contact_ids" eval="[(6, 0, [ref('partner_khach_hang_b')])]" />
        <field name="x_chatwoot_contact_id">cw_contact_002</field>
        <field name="x_chatwoot_inbox_id">202</field>
        <field name="active">True</field>
    </record>

    <record id="conv_003" model="chatopia.conversation">
        <field name="name">Yêu cầu báo giá - Công Ty TNHH Giải Pháp XYZ</field>
        <field name="chatwoot_conversation_id">1003</field>
        <field name="chatwoot_conversation_ids" eval="[1003]"/>
