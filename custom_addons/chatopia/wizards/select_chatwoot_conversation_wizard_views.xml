<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_select_chatwoot_conversation_wizard_form" model="ir.ui.view">
            <field name="name">chatopia.select.chatwoot.conversation.wizard.manual.form</field>
            <field name="model">chatopia.select.chatwoot.conversation.wizard</field>
            <field name="arch" type="xml">
                <form string="Send Message to Specific Chatwoot Conversation">
                    <group>
                        <field name="conversation_odoo_id" invisible="1"/>
                        <group string="Message Preview" colspan="2">
                            <field name="message_content_display" nolabel="1" readonly="1" class="oe_no_resize" style="min-height: 60px; min-width: 500px; width: 100%"/>
                        </group>
                        <group string="Available Targets Information" colspan="2">
                            <!-- Bỏ widget="html", chỉ dùng style -->
                            <field name="available_ids_info" nolabel="1" readonly="1" style="white-space: pre-wrap; font-size: 0.9em; color: #555; min-height: 70px; min-width: 500px; width: 100%; border: 1px solid #ccc; padding: 5px; background-color: #f9f9f9;"/>
                        </group>
                        <group colspan="2" col="2">
                            <label for="target_chatwoot_conv_id_input" string="Send to Chatwoot ID:"/>
                            <field name="target_chatwoot_conv_id_input" nolabel="1" placeholder="Enter Chatwoot Conversation ID"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm_send" string="Send Message" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>